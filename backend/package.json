{
  "name": "velion-api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev":        "tsx watch src/index.ts",
    "build":      "tsc --project tsconfig.json",
    "start":      "node dist/index.js",
    "db:generate":"drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed":              "tsx src/db/seed.ts",
    "db:seed:general-items":"tsx src/db/seed_general_items.ts",
    "db:studio":  "drizzle-kit studio",
    "db:push":    "drizzle-kit push"
  },
  "dependencies": {
    "express":           "^4.21.1",
    "cors":              "^2.8.5",
    "helmet":            "^8.0.0",
    "express-rate-limit":"^7.4.1",
    "socket.io":         "^4.8.1",
    "drizzle-orm":       "^0.36.4",
    "pg":                "^8.13.1",
    "bcrypt":            "^5.1.1",
    "jsonwebtoken":      "^9.0.2",
    "stripe":            "^17.3.1",
    "@aws-sdk/client-s3":"^3.693.0",
    "@aws-sdk/s3-request-presigner":"^3.693.0",
    "uuid":              "^11.0.3",
    "zod":               "^3.23.8",
    "dotenv":            "^16.4.5"
  },
  "devDependencies": {
    "@types/express":      "^5.0.0",
    "@types/cors":         "^2.8.17",
    "@types/bcrypt":       "^5.0.2",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/pg":           "^8.11.10",
    "@types/uuid":         "^10.0.0",
    "@types/node":         "^22.9.1",
    "typescript":          "^5.6.3",
    "tsx":                 "^4.19.2",
    "drizzle-kit":         "^0.28.1"
  }
}